<%- include('../partials/header') %>

<%- include('../partials/navi', {activePage: 'profile'}) %>

<div class="main-content">
    <div class="profile-header">
        <button onclick="window.location.href='<%= from || `/dashboard` %>'" class="back-button">
            <i class="fa-solid fa-circle-chevron-left"></i> <span>Back</span>
        </button>
        <h2 class="title">
            <%= isOwnProfile ? "Your Profile" : `${profileUser.firstName}'s Profile` %>
        </h2>
    </div>
        <p class="error-msg">
            <%= errorMessage %>
        </p>
<div class="profile-page">
    <div class="card profile-card">
        <img
            src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= profileUser.avatarSeed || profileUser.username %>"
            alt="<%= profileUser.username %>"
            class="profile-page-picture">
            <% if (isOwnProfile) { %>
                <form method="POST" action="/profile/avatar/randomise">
                    <button class="avatar-change" type="submit"><i class="fa-solid fa-shuffle"></i> Randomise</button>
                </form>
            <% } %>
            <div class="username-container">
            <h2 class="profile-username"><%= profileUser.username %></h2>

            <% if (isOwnProfile) { %>
                <form method="POST" class="edit-username-form" action="/profile/update-username">
                <input
                    type="text"
                    name="username"
                    class="profile-username-input hidden"
                    value="<%= profileUser.username %>"
                    required
                >

                <button class="edit-username-btn" type="button">
                    <i class="fa-regular fa-pen-to-square"></i>
                </button>
                <div class="username-btns">
                    <button class="save-username-btn hidden" type="submit">
                        Save
                    </button>

                    <button class="cancel-username-btn hidden" type="button">
                        Cancel
                    </button>
                </div>
                </form>
            <% } %>
            </div>
            <% if (isOwnProfile) { %>
                <div class="password-section">

                <button class="edit-profile-btn change-password-btn" type="button">
                    <i class="fa-regular fa-pen-to-square"></i>
                    Change Password
                </button>

                <form method="POST"
                    action="/profile/update-password"
                    class="edit-password-form hidden">

                    <input
                        type="password"
                        name="currentPassword"
                        placeholder="Current Password"
                        required>

                    <input
                        type="password"
                        name="newPassword"
                        placeholder="New Password"
                        required>

                    <input
                        type="password"
                        name="confirmPassword"
                        placeholder="Confirm New Password"
                        required>

                    <div class="password-actions">
                        <button type="submit" class="save-password-btn">
                            Save
                        </button>

                        <button type="button" class="cancel-password-btn">
                            Cancel
                        </button>
                    </div>
                </form>

            </div>
            <% } %>
        <h3><%= profileUser.firstName %> <%= profileUser.lastName %></h3>


        <% if (isOwnProfile) { %>
            <p><strong>Email:</strong> <%= profileUser.email %></p>
        <% } %>

        <% if (isOwnProfile) { %>
            <div class="card-spacer"></div>
            <div class="delete-acc-container">
                <button type="button" class="delete-profile-btn" id="show-del-confirmation">
                    <i class="fa-solid fa-user-xmark"></i> Delete Account
                </button>
                <form class="delete-profile-form hidden" method="POST" action="/profile/delete">
                    <p class="no-items">Are you sure you want to delete your account? This action is irreversible</p>
                    <p>type DELETE to confirm</p>
                    <input 
                    type="text" 
                    name="delete-confirm" 
                    id="delete-confirm-input" 
                    placeholder="type DELETE"
                    autotcomplete="off"
                    required>
                    <input type="hidden" value="<%= profileUser._id %>">

                    <div class="del-profile-actions">
                        <button type="submit" class="delete-profile-btn" id="final-del-btn" disabled>Confirm</button>
                        <button type="button" class="delete-profile-btn" id="cancel-del-btn">Cancel</button>
                    </div>
                </form>
            </div>
        <% } else if (alreadyFriends) { %>
            <div class="card-spacer"></div>
            <i class="fa-solid fa-user-check add-friends-icon" style="color: green;"></i><span style="color: green;">Friends</span>
            <form class="remove-friend-form" method="POST" action="/friends/remove">
                <input type="hidden" name="friendId" value="<%= profileUser._id %>">
                <button type="submit" class="remove-friends-btn">
                    <i class="fa-solid fa-user-minus remove-friends-icon"></i> Unfriend
                </button>
            </form>
        <% } else { %>
            <div class="card-spacer"></div>
            <form method="POST" action="/friends/add">
                <input type="hidden" name="friendId" value="<%= profileUser._id %>">
                <button type="submit" class="add-friends-btn"> 
                    <i class="fa-solid fa-user-plus add-friends-icon"></i> Add Friend
                </button>
            </form>
        <% } %>

    </div>

    <div class="profile-right-column">
        <div class="card friendsList-card">
            <h3><%= isOwnProfile ? "Your friends" : `${profileUser.firstName}'s friends` %></h3>

            <% if (profileUser.friendsList.length === 0) { %>
                <p class="no-items">
                    <%= isOwnProfile ? "You have no friends yet" : "This user has no friends yet" %>
                </p>
            <% } %>

            <% if (profileUser.friendsList.length) { %>
                <div class="friends-container">
                    <% profileUser.friendsList.forEach(friend => { %>
                        <div class="friend-card clickable" data-username="<%= friend.username %>">
                            <img
                                src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= friend.avatarSeed || friend.username %>"
                                alt="<%= friend.username %>"
                                class="friend-img">
                            <p><%= friend.username %></p>

                            <% if (isOwnProfile) { %>
                                <form id="remove-friend-form" method="POST" action="/friends/remove">
                                    <input type="hidden" name="friendId" value="<%= friend._id %>">
                                    <button type="submit" class="remove-friend-btn">
                                        <i class="fa-solid fa-user-minus remove-friend-icon"></i>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
        <div class="card playing-card">
            <h3><%= isOwnProfile ? "What you're playing" : `What ${profileUser.firstName}'s playing` %></h3>

            <% if (playing.length === 0) { %>
             <p class="no-items">
                <%= isOwnProfile ? "You have no games marked as playing" : "This user has no games marked as playing" %>
             </p>
            <% } %>

            <% if (playing.length > 0) { %>
                <div class="profile-games
                <%= playing.length <= 3 ? "profile-center" : ""%>
                <%= playing.length <= 5 ? "profile-center-mobile" : ""%>
                ">
                    <% playing.forEach(game => { %>
                        <div class="profile-game-card"
                            data-game-id="<%= game.gameId %>">
                            <img
                                class="profile-game-img"
                                src="<%= game.cachedCoverUrl.replace('t_cover_big', 't_thumb') %>"
                                alt="<%= game.cachedName %>">
                            <p class="profile-game-name"><%= game.cachedName %></p>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <div class="card review-card">
            <h3><%= isOwnProfile ? "Your Reviews" : `${profileUser.firstName}'s Reviews` %></h3>

            <% if (userReviews.length === 0) { %>
                <p class="no-items">
                    <%= isOwnProfile ? "You have not written any reviews yet" : "This user has not written any reviews yet" %>
                </p>
            <% } %>

            <% if (userReviews.length > 0) { %>
                <div class="profile-reviews">
                    <% userReviews.forEach(review => { %>
                        <div class="profile-review-card clickable">
                            <div class="profile-review-header">
                                <img
                                    class="profile-review-img"
                                    src="<%= review.cachedCoverUrl.replace('t_cover_big', 't_thumb') %>"
                                    alt="<%= review.cachedName %>">
                                <div class="profile-review-header-text">
                                    <p class="profile-review-game"><%= review.cachedName %></p>
                                    <p class="profile-review-title"><%= review.title %></p>
                                </div>
                            </div>
                            <p class="profile-review-body"><%= review.body %></p>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
</div>
</div>
<script>
    const games = document.querySelectorAll('.profile-game-card');

    games.forEach(game => {
        game.addEventListener('click', () => {

            const gameId = game.dataset.gameId;
            const from = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/game/${gameId}?from=${from}`;
        });
    });

    const friendcard = document.querySelectorAll('.friend-card');

    friendcard.forEach(card => {
        card.addEventListener('click', (e) => {
            if(e.target.closest('form, button')) return; // Prevent navigation when clicking the remove friend button
            
            const userId = card.dataset.username;
            const from = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/users/${userId}?from=${from}`;
        });
    });
</script>
<script>
    const showBtn = document.getElementById('show-del-confirmation')
    const delForm = document.querySelector('.delete-profile-form')
    const cancelBtn = document.getElementById('cancel-del-btn')
    const input = document.getElementById('delete-confirm-input')
    const finalBtn = document.getElementById('final-del-btn')

    showBtn.addEventListener('click', () => {
        showBtn.classList.add('hidden')
        delForm.classList.remove('hidden')
        input.focus()
    })
    cancelBtn.addEventListener('click', () => {
        showBtn.classList.remove('hidden')
        delForm.classList.add('hidden')
        input.value = ''
        finalBtn.disabled = true
    })
    input.addEventListener('input', () => {
        if(input.value !== "DELETE") {
            finalBtn.disabled = true
        } else {
            finalBtn.disabled = false
        }
    })
</script>
<script>
  const editUsernameBtn = document.querySelector(".edit-username-btn");
  const saveUsernameBtn = document.querySelector(".save-username-btn");
  const cancelUsernameBtn = document.querySelector(".cancel-username-btn");
  const usernameText = document.querySelector(".profile-username");
  const usernameInput = document.querySelector(".profile-username-input");

  if (editUsernameBtn) {
    editUsernameBtn.addEventListener("click", () => {
      usernameText.classList.add("hidden");
      usernameInput.classList.remove("hidden");

      editUsernameBtn.classList.add("hidden");
      saveUsernameBtn.classList.remove("hidden");
      cancelUsernameBtn.classList.remove("hidden");

      usernameInput.focus();
      usernameInput.select();
    });

    cancelUsernameBtn.addEventListener("click", () => {
      usernameInput.value = usernameText.textContent.trim();

      usernameText.classList.remove("hidden");
      usernameInput.classList.add("hidden");

      editUsernameBtn.classList.remove("hidden");
      saveUsernameBtn.classList.add("hidden");
      cancelUsernameBtn.classList.add("hidden");
    });
  }
</script>
<script>
    const passwordBtn = document.querySelector(".change-password-btn");
    const passwordForm = document.querySelector(".edit-password-form");
    const cancelPasswordBtn = document.querySelector(".cancel-password-btn");

    if(passwordBtn) {
        passwordBtn.addEventListener("click", () => {
            passwordBtn.classList.add("hidden");
            passwordForm.classList.remove("hidden");
        });
    }

    if(cancelPasswordBtn) {
        cancelPasswordBtn.addEventListener("click", () => {
            passwordBtn.classList.remove("hidden");
            passwordForm.classList.add("hidden");

            passwordForm.reset();
        });
    }
</script>
<%- include('../partials/footer') %>