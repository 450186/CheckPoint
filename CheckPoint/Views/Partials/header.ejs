<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PlayVault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Share+Tech&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    referrerpolicy="no-referrer" 
/>
<link rel="icon" type="image/png" sizes="64x64" href="/assets/logos/PlayVault-logo64.png">
<script src="Modalfunction.js" defer></script>
</head>
<body>
    
<header class=" <%= (title == "Home" || title == "Login" || title == "Register") ? "centered" : "" %>">
    <% if (title == "Home" || title == "Login" || title == "Register") { %>
      <div class="logo-container">
        <img src="/assets/logos/PlayVault-logo64.png" class="logo" alt="PlayVault">
        <h1>PlayVault</h1>
      </div>
    <% } else { %>
      <div class="logo-container">
        <img src="/assets/logos/PlayVault-logo64.png" class="logo" alt="PlayVault">
        <a href="/dashboard">
            <h1>PlayVault</h1>
        </a>
      </div>
    <% } %>
    <% if (title !== "Home" && title !== "Login" && title !== "Register") { %>
    <form action="/search" method="GET">
        <div id="search-container">
        <input
        name="query"
        type="search"
        id="search"
        placeholder="Search games..."
        autocomplete="off"
        value="<%= typeof query !== 'undefined' ? query : '' %>"
        onfocus="this.value=''"
        >
            <button id="search-btn" type="submit" >
                <i class="fa-solid fa-magnifying-glass fa-rotate-90 search-btn"></i>
            </button>
        </div>
    </form>
    <div class="right-side">
      <div class="noti-header-container">
        <button id="noti-open" class="open-noti-btn" aria-label="Notifications" type="button">
        <i class="fa-solid fa-bell open-noti-icon"></i>
        <% if (friendRequests.length > 0) { %>
            <span class="noti-badge"> <%= friendRequests.length %> </span>
        <% } %>
      </button>
      </div>
        <button id="open-friend-modal-btn" class="add-friends-btn" aria-label="Add Friends" type="button">
            <i class="fa-solid fa-user-plus add-friends-icon"></i>
        </button>
        <div class="account-container">
            <img src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= user?.avatarSeed || user?.username %>" alt="Account Logo" class="account-logo"> 
        </div>
    </div>
    <div class="noti-dropdown">
      <% if (friendRequests.length === 0) { %>
        <p class="no-items" style="text-align: center; font-weight: bold;">You have no friend requests</p>
      <% } %>
      <% friendRequests.forEach(request => { %>
        <div class="noti-container clickable" data-username ="<%= request?.username %>">
          <img src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= request?.avatarSeed || request?.username %>" alt="Account Logo" class="noti-logo">
          <p><%= request.username %> wants to be friends</p>
          <div class="request-actions">
            <form id="accept-friend-request-form" method="POST" action="/friends/accept">
              <input type="hidden" name="friendId" value="<%= request._id %>">
              <button type="submit" class="accept-request-btn">
                <i class="fa-solid fa-user-plus accept-request-icon"></i>
              </button>
            </form>
            <form id="decline-friend-request-form" method="POST" action="/friends/reject">
              <input type="hidden" name="friendId" value="<%= request._id %>">
              <button type="submit" class="reject-request-btn">
                <i class="fa-solid fa-user-minus reject-request-icon"></i>
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

     <div class="account-dropdown">
        <ul>
            <li><a href="/profile?from=<%= encodeURIComponent(requestPath || '/dashboard') %>" role="menuitem"><i class="fa-solid fa-circle-user"></i> Profile</a></li>
            <li><a href="/settings" role="menuitem"><i class="fa-solid fa-user-gear"></i> Settings</a></li>
            <li><a href="/logout" role="menuitem"><i class="fa-solid fa-right-from-bracket"></i> Logout</a></li>
        </ul>
    </div>

    <% } %>
    <% if (title == "Home") { %>
        <div class="home-links">
            <a href="login">Login</a>
            <a href="register">Register</a>
        </div>
    <% } %>

    <% if (title !== "Home" && title !== "Register" && title !== "Login") { %>
        <%- include('../Partials/Modal') %>
    <% } %>

    <script>
    // Dropdown menu functionality
    const accountContainer = document.querySelector('.account-container');
    const dropdown = document.querySelector('.account-dropdown');
    accountContainer.addEventListener('click', function() {
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    });
        // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        if (!accountContainer.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
        }
    });
    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            dropdown.style.display = 'none';
        }
    });
    //dropdown notification center functionality
    const notiDropdown = document.querySelector('.noti-dropdown');
    const notiOpen = document.querySelector('.open-noti-btn');
    const notifications = document.querySelectorAll(".noti-container")

    notiOpen.addEventListener('click', function() {
        notiDropdown.style.display = notiDropdown.style.display === 'block' ? 'none' : 'block';
        const rect = notiOpen.getBoundingClientRect();
        notiDropdown.style.left = `${rect.left + rect.width / 2}px`;
        notiDropdown.style.top = `${rect.top + 60 + window.scrollY}px`;
        notiDropdown.style.transform = "translateX(-50%)";
    });
    document.addEventListener('click', function(event) {
        if (!notiOpen.contains(event.target) && !notiDropdown.contains(event.target)) {
            notiDropdown.style.display = 'none';
        }
    });
    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            notiDropdown.style.display = 'none';
        }
    });
    notifications.forEach(noti => {
      noti.addEventListener('click', () => {
          const userId = noti.dataset.username;
          const from = encodeURIComponent(window.location.pathname + window.location.search);
          showPageLoader("Loading Profile...")
          window.location.href = `/users/${userId}?from=${from}`;
      })
    })
    </script>
<!-- ADD FRIEND MODAL -->
<div id="friend-modal" class="modal-overlay" aria-hidden="true">
  <div
    class="modal friend-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="friend-modal-title"
  >
    <div class="modal-info">
      <div class="modal-header">
        <h2 id="friend-modal-title">Add a Friend</h2>
        <button
          class="modal-close friend-modal-close"
          type="button"
          aria-label="Close add friend dialog"
        >
          &CircleTimes;
        </button>
      </div>

      <form action="/friends/search" method="GET" class="friend-search-form">
        <label for="friend-search-input"><strong>Search by username</strong></label>
        <input
          type="search"
          name="query"
          id="friend-search-input"
          placeholder="Enter a username..."
          autocomplete="off"
          required
        >

        <div class="modal-actions">
          <button type="submit" class="add-btn">Search</button>
          <button
            type="button"
            class="go-to-game"
            id="friend-cancel-btn"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<div id="page-loader" class="page-loader" hidden>
    <div class="page-loader-content">
        <div class="vault-wheel">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <p>Loading...</p>
    </div>
</div>
<script>
  function showPageLoader(message = "Loading...") {
    const loader = document.getElementById("page-loader");
    if (!loader) return;

    const text = loader.querySelector("p");
    if (text) text.textContent = message;

    loader.hidden = false;
  }

  document.addEventListener("click", (event) => {
    const link = event.target.closest("a");
    if (!link) return;

    const href = link.getAttribute("href");
    if (!href) return;

    if (
      href.startsWith("#") ||
      href.startsWith("http") ||
      href.startsWith("javascript:") ||
      link.hasAttribute("download") ||
      link.target === "_blank"
    ) {
      return;
    }

    if (href.startsWith("/discover")) {
      showPageLoader("Loading the discovery page...");
    } else if (href.startsWith("/game")) {
      showPageLoader("Loading game...");
    } else {
      showPageLoader("Loading...");
    }
  });

  window.addEventListener("pageshow", (event) => {
    const loader = document.getElementById("page-loader");
    if (!loader) return;

    if (event.persisted) {
      loader.hidden = true;
    }
  });

  window.addEventListener("load", () => {
    const loader = document.getElementById("page-loader");
    if (loader) loader.hidden = true;
  });
</script>

<script src="/addFriendFunction.js"></script>
</header>