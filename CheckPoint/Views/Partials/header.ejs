<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CheckPoint</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Share+Tech&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    referrerpolicy="no-referrer" 
/>
<script src="Modalfunction.js" defer></script>
</head>
<body>
    
<header class=" <%= (title == "Home" || title == "Login" || title == "Register") ? "centered" : "" %>">
    <% if (title == "Home" || title == "Login" || title == "Register") { %>
     <h1>CheckPoint</h1>
    <% } else { %>
    <a href="/dashboard">
        <h1>CheckPoint</h1>
    </a>
    <% } %>
    <% if (title !== "Home" && title !== "Login" && title !== "Register") { %>
    <form action="/search" method="GET">
        <div id="search-container">
        <input
        name="query"
        type="search"
        id="search"
        placeholder="Search games..."
        autocomplete="off"
        value="<%= typeof query !== 'undefined' ? query : '' %>"
        onfocus="this.value=''"
        >
            <button id="search-btn" type="submit" >
                <i class="fa-solid fa-magnifying-glass fa-rotate-90 search-btn"></i>
            </button>
        </div>
    </form>
    <div class="right-side">
        <button id="open-friend-modal-btn" class="add-friends-btn" aria-label="Add Friends" type="button">
            <i class="fa-solid fa-user-plus add-friends-icon"></i>
        </button>
        <div class="account-container">
            <p class="account-name"><%= user?.username || 'Account' %></p>
            <img src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= user?.avatarSeed || user?.username %>" alt="Account Logo" class="account-logo"> 
        </div>
    </div>

     <div class="account-dropdown">
        <ul>
            <li><a href="/profile?from=<%= encodeURIComponent(requestPath || '/dashboard') %>" role="menuitem"><i class="fa-solid fa-circle-user"></i> Profile</a></li>
            <li><a href="/settings" role="menuitem"><i class="fa-solid fa-user-gear"></i> Settings</a></li>
            <li><a href="/logout" role="menuitem"><i class="fa-solid fa-right-from-bracket"></i> Logout</a></li>
        </ul>
    </div>

    <% } %>
    <% if (title == "Home") { %>
        <div class="home-links">
            <a href="login">Login</a>
            <a href="register">Register</a>
        </div>
    <% } %>

    <% if (title !== "Home" && title !== "Register" && title !== "Login") { %>
        <%- include('../Partials/Modal') %>
    <% } %>

    <script>
    // Dropdown menu functionality
    const accountContainer = document.querySelector('.account-container');
    const dropdown = document.querySelector('.account-dropdown');
    accountContainer.addEventListener('click', function() {
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    });
        // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        if (!accountContainer.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
        }
    });
    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            dropdown.style.display = 'none';
        }
    });
    </script>
<!-- ADD FRIEND MODAL -->
<div id="friend-modal" class="modal-overlay" aria-hidden="true">
  <div
    class="modal friend-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="friend-modal-title"
  >
    <div class="modal-info">
      <div class="modal-header">
        <h2 id="friend-modal-title">Add a Friend</h2>
        <button
          class="modal-close friend-modal-close"
          type="button"
          aria-label="Close add friend dialog"
        >
          &CircleTimes;
        </button>
      </div>

      <form action="/friends/search" method="GET" class="friend-search-form">
        <label for="friend-search-input"><strong>Search by username</strong></label>
        <input
          type="search"
          name="query"
          id="friend-search-input"
          placeholder="Enter a username..."
          autocomplete="off"
          required
        >

        <div class="modal-actions">
          <button type="submit" class="add-btn">Search</button>
          <button
            type="button"
            class="go-to-game"
            id="friend-cancel-btn"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/addFriendFunction.js"></script>
</header>