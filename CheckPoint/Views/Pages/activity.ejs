<%- include('../Partials/header') %>

<%- include('../Partials/navi', {activePage: 'activity'}) %>

<div class="main-content">
    <h2 class="title">Recent Activity</h2>
    <p class="error-msg"><%= errorMessage %></p>

    <div class="filter-container" id="activity-filters">
        <div class="filter-item">
            <button class="filter-btn active-filter" data-filter="all">All</button>
        </div>
        <div class="filter-item">
            <button class="filter-btn" data-filter="review">Reviews</button>
        </div>
        <div class="filter-item">
            <button class="filter-btn" data-filter="status">Status Updates</button>
        </div>
    </div>

    <div class="activity">
        <% if (activityFeed.length === 0) { %>
            <p class="no-items">Your friends haven't been very busy recently!</p>
        <% } %>
        <% activityFeed.forEach(activity => { %>
            <div class="activity-card clickable"
            data-game-id = "<%= activity.gameId %>"
            data-type = "<%= activity.type %>"
            >
                    <img class="activity-avatar clickable" 
                    data-username="<%= activity.user.username %>" 
                    src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= activity.user.avatarSeed || activity.user.username %>" 
                    alt="<%= activity.user.username %>">
                    <div class="activity-content">
                        <p class="activity-msg-line">
                            <strong class="activity-username" data-username="<%= activity.user.username %>"><%= activity.user.username %></strong>
                            <% if (activity.type === "review") { %>
                             Reviewed <em><strong><%= activity.gameName %></strong></em>
                            <% } else if (activity.type === "status") { %>
                                added <strong><%= activity.gameName %></strong> to their <strong><%= activity.status %></strong> collection
                                <% if (activity.userRating !== null) { %>
                                    <div class="activity-rating">
                                        <p><%= activity.user.username %>'s Rating: </p>
                                        <div class="activity-star-rating">
                                            <% for( let i = 1; i <= 5; i++) { %>
                                                <% if (activity.userRating >= i) { %>
                                                    <i class="fa-solid fa-star"></i>
                                                <% } else if (activity.userRating >= i - 0.5) { %>
                                                    <i class="fa-solid fa-star-half-stroke"></i>
                                                <% } else { %>
                                                    <i class="fa-regular fa-star"></i>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </div>
                                <% } %>
                            <% } %>
                        </p>
                        <% if (activity.type === "review") { %>
                            <p class="activity-review-title"><em><%= activity.title %></em></p>
                            <p class="activity-review-body"><%= activity.body %></p>
                            <% if (activity.rating !== null) { %>
                                <div class="activity-rating">
                                    <p><%= activity.user.username %>'s Rating: </p>
                                    <div class="activity-star-rating">
                                        <% for( let i = 1; i <= 5; i++) { %>
                                            <% if (activity.rating >= i) { %>
                                                <i class="fa-solid fa-star"></i>
                                            <% } else if (activity.rating >= i - 0.5) { %>
                                                <i class="fa-solid fa-star-half-stroke"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-star"></i>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                        <div class="card-spacer"></div>
                        <p class="activity-timestamp">
                            <%= activity.timeAgo %>
                        </p>
                    </div>
                    <img class="activity-game-img" src="<%= activity.coverUrl.replace('t_cover_big', 't_thumb') %>" alt="<%= activity.gameName %>">
            </div>
        <% }) %>
    </div>
</div>
<script>
    const activityCards = document.querySelectorAll('.activity-card');

    activityCards.forEach(card => {
        card.addEventListener('click', () => {
            console.log(card.dataset.gameId)
            const gameId = card.dataset.gameId;
            if(gameId) {
                const from = encodeURIComponent(window.location.pathname + window.location.search);
                window.location.href = `/game/${gameId}?from=${from}`
            }
        });
    });

    const usernames = document.querySelectorAll('.activity-username');
    const userAvatars = document.querySelectorAll('.activity-avatar');

    usernames.forEach(user => {
        user.addEventListener('click', (e) => {
            e.stopPropagation(); // Prevent the card click event from firing
            const clickedUser = user.dataset.username
            window.location.href = `/users/${clickedUser}`;
        })
    });

    userAvatars.forEach(avatar => {
        avatar.addEventListener('click', (e) => {
            e.stopPropagation(); // Prevent the card click event from firing
            const clickedUser = avatar.dataset.username
            window.location.href = `/users/${clickedUser}`;
        })
    });

    const filterBtns = document.querySelectorAll('.filter-btn');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const selectedFilter = btn.dataset.filter;

            filterBtns.forEach(b => b.classList.remove('active-filter'));
            btn.classList.add('active-filter');

            activityCards.forEach(card => {
                const cardType = card.dataset.type;

                if (selectedFilter === 'all' || cardType === selectedFilter) {
                    card.style.display = 'grid';
                } else {
                    card.style.display = 'none';
                }
            })
        })
    })
</script>
<%- include('../Partials/footer') %>