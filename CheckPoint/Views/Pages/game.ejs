<%- include('../Partials/header') %>

<%- include('../Partials/navi', {activePage: 'game'}) %>

<div class="main-content game-main-page">
        <button onclick="showPageLoader('<%= from.startsWith('/discover') ? 'Loading discover...' : 'Loading...' %>'); window.location.href='<%= from %>'" 
            class="back-button">
            <i class="fa-solid fa-circle-chevron-left"></i> <span>Back</span>
        </button>
    <div class="game-info-container">
        <div class="game-cover-container"> 
            <img src="<%= game.coverUrl %>"
                alt="<%= game.name %>" class="game-cover">
        </div>
        <div class="game-details">
            <h2><%= game.name %></h2>
            <p class="game-info"><strong>Developer:</strong>
                <%= game.developer %>
            </p>
            <p class="game-info"><strong>Description:</strong>
                <%= game.description %>
            </p>
            <% if (game.gameModes) { %>
                <p class="game-info"><strong>Game Modes:</strong>
                    <%= game.gameModes ? game.gameModes.join(', ') : 'Unknown' %>
                </p>             
            <% } %>
            <p class="game-info"><strong>Genre:</strong>
                <%= (game.genres && game.genres.length) ? game.genres.join(', '): 'Unknown' %>
            </p>
            <p class="game-info"><strong>Platform:</strong>
                <%= (game.platforms && game.platforms.length) ? game.platforms.join(', '): 'Unknown' %>
            </p>
            <p class="game-info"><strong>Release Date:</strong>
                <%= game.releaseDate ? new Date(game.releaseDate * 1000).toLocaleDateString("en-GB", {day: "2-digit",month: "short",year: "numeric"}) : "Unknown" %>
            </p>
            <% if (isInLibrary) { %>
                <button type="button" 
                id="open-review-modal-btn" 
                data-game-id="<%= game.id %>"
                data-name="<%= game.name %>"
                data-cover="<%= game.coverUrl %>"
                data-rating="<%= userLibraryItem?.userRating || '' %>"
                class="add-btn">
                    Add Review
                </button>
            <% } %>
        </div>
        <div class="game-right-side">
            <div class="game-rating-div">
                <div class="game-rating">
                    <h2><%= game.rating ? Math.round(game.rating) : "N/A" %></h2>
                    <span class="out-of-rating"> / 100</span>
                </div>
                <p style="margin-top: 20px; margin-bottom: 0;">Critics' Rating</p>
            </div>
                    <% if (totalTracked > 0) { %>
        <div class="community-status-container">
            <h3 style="margin-top: 0;">Community Status:</h3>
                <div class="community-bar">
                    <div class="community-fill playing-fill" 
                    style="width: <%= statusPercents.playing %>%;" 
                    title="Playing: <%= statusMap.playing %> users (<%= statusPercents.playing %>%)">
                </div>
                    <div class="community-fill completed-fill"
                     style="width: <%= statusPercents.completed %>%;" 
                     title="Completed: <%= statusMap.completed %> users (<%= statusPercents.completed %>%)">
                </div>
                    <div class="community-fill dropped-fill" 
                    style="width: <%= statusPercents.dropped %>%;" 
                    title="Dropped: <%= statusMap.dropped %> users (<%= statusPercents.dropped %>%)">
                </div>
                    <div class="community-fill wishlist-fill" 
                    style="width: <%= statusPercents.wishlist %>%;" 
                    title="Wishlist: <%= statusMap.wishlist %> users (<%= statusPercents.wishlist %>%)">
                </div>
                </div>
                <div class="community-status-legend">
                    <span><i class="fa-solid fa-circle-dot playing-dot"></i><strong>Playing: </strong><%= statusMap.playing %></span>
                    <span><i class="fa-solid fa-circle-dot completed-dot"></i><strong>Completed: </strong><%= statusMap.completed %></span>
                    <span><i class="fa-solid fa-circle-dot dropped-dot"></i><strong>Dropped: </strong><%= statusMap.dropped %></span>
                    <span><i class="fa-solid fa-circle-dot wishlist-dot"></i><strong>Wishlist: </strong><%= statusMap.wishlist %></span>
                </div>
        </div>
                <% } %>
        <% if (game.completion.rushed !== null && game.completion.main !== null && game.completion.completionist !== null) { %>
            <div class="completion-grid">
                <p class="grid-header"><strong>Time to Complete</strong></p>
                <p class="header-cell">Hastily</p>
                <p class="header-cell">Main Story</p>
                <p class="header-cell">Complete</p>

                <p class="time-cell"><%= game.completion.rushed != null ? `${game.completion.rushed} hours` : "No Record" %></p>
                <p class="time-cell"><%= game.completion.main != null ? `${game.completion.main} hours` : "No Record" %></p>
                <p class="time-cell"><%= game.completion.completionist != null ? `${game.completion.completionist} hours` : "No Record" %></p>
            </div>
        <% } %>
        </div>

    </div>
    <% if (reviews.length > 0) { %>
        <h3>User's Reviews</h3>
        <div class="review-row-wrap <%= reviews.length > 3 ? 'scrollable' : '' %>">
            <div class="review-row <%= reviews.length <= 3 ? 'few-reviews' : '' %>">
                <% reviews.forEach(r => { %>
                    <div class="game-review-card">
                        <div class="review-card-content">
                            <div class="game-review-header">
                                <h3><%= r.title %></h3>
                                <% if (r.ownReview) { %>
                                    <div class="review-btns">
                                        <form action="/reviews/delete" class="review-remove-form" onclick="event.stopPropagation()" method="POST">
                                            <input type="hidden" name="reviewId" value="<%= r.reviewId %>">
                                            <input type="hidden" name="gameId" value="<%= r.gameId %>">
                                            <button type="submit" class="delete-btn" onclick="event.stopPropagation()">
                                                <i class="fa-solid fa-trash"></i> Delete</button>
                                        </form>
                                        <form action="/reviews/edit" onclick="event.stopPropagation()" method="POST">
                                            <input type="hidden" name="gameId" value="<%= r.gameId %>">
                                            <input type="hidden" name="reviewId" value="<%= r.reviewId %>">
                                            <button type="submit" class="edit-btn">
                                                <i class="fa-solid fa-pen"></i> Edit</button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                            <p><%= r.body %></p>
                        </div>
                        <div class="card-spacer"></div>
                            <div class="activity-star-rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <% if (r.rating >= i) { %>
                                        <i class="fa-solid fa-star"></i>
                                    <% } else if (r.rating >= i - 0.5) { %>
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                    <% } else { %>
                                        <i class="fa-regular fa-star"></i>
                                    <% } %>
                                <% } %>
                            </div>

                        <div class="review-byline">
                            <img
                                src="https://api.dicebear.com/7.x/thumbs/svg?seed=<%= r.user.avatarSeed || r.user.username %>"
                                alt="<%= r.user.username %>'s avatar"
                                class="activity-avatar clickable"
                                data-username="<%= r.user.username %>"
                            >
                            <p class="activity-username" data-username="<%= r.user.username %>"><strong><%= r.user.username %></strong></p>
                            <p><%= r.timeAgo %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>   
    <div id="confirm-overlay" class="confirm-overlay" hidden>
        <div class="confirm-box">
            <h3>Are you sure you want to delete your review of <em>"<%= game.name %>"</em> called
                <span class="confirm-game-name"></span>
                ?</h3>
            <div class="confirm-buttons">
                <button id="cancel-remove" type="button">Cancel</button>
                <button id="confirm-remove" type="button">Remove</button>
            </div>
        </div>
    </div>
<% if (moreFromDev && moreFromDev.length) { %>
        <h3>More From <strong>
                <%= game.developer %>
            </strong></h3>
        <div class="library-row">
            <% moreFromDev.forEach(g => { %>
            <div class="library-card"
            data-game-id="<%= g.id %>"
            data-name="<%= g.name %>"
            data-cover="http:<%= g.cover.url.replace('t_thumb', 't_cover_big') %>"
            data-genres="<%= g.genres ? g.genres.map(game => game.name).join(', ') : 'Unknown' %>"
            data-rating="<%= g.aggregated_rating ? Math.round(g.aggregated_rating) : '' %>"
            data-release="<%= g.first_release_date ? new Date(g.first_release_date * 1000).toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}) : 'Unknown' %>"
            >
                <div class="game-card-header">
                    <% if (g.cover && g.cover.url) { %>
                     <img
                            src="http:<%= g.cover.url.replace('t_thumb', 't_cover_big') %>"
                            alt="<%= g.name %>"
                            class="game-cover"> 
                    <% } %>
                    <p><strong>
                            <%= g.name %>
                        </strong></p>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
    <% if (similarGenres && similarGenres.length) { %>
        <h3>Similar Games</h3>
        <div class="library-row">
            <% similarGenres.forEach(g => { %>
                <div class="library-card"
                data-game-id="<%= g.id %>"
                data-name="<%= g.name %>"
                data-cover="http:<%= g.cover.url.replace('t_thumb', 't_cover_big') %>"
                data-genres="<%= g.genres ? g.genres.map(game => game.name).join(', ') : 'Unknown' %>"
                data-rating="<%= g.aggregated_rating ? Math.round(g.aggregated_rating) : '' %>"
                data-release="<%= g.first_release_date ? new Date(g.first_release_date * 1000).toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}) : 'Unknown' %>"
            >
                <div class="game-card-header">
                    <% if (g.cover && g.cover.url) { %>
                     <img
                            src="http:<%= g.cover.url.replace('t_thumb', 't_cover_big') %>"
                            alt="<%= g.name %>"
                            class="game-cover"> 
                    <% } %>
                    <p><strong>
                            <%= g.name %>
                        </strong></p>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
            <div class="media-section">
                <div class="screenshot-container">
                    <% if (game.screenshots.length === 0) { %>
                     <p class="error-msg">No Screenshots</p>
                    <% } %>
                <% if (game.screenshots.length) { %>
                    <h3 style="text-align: center;">Screenshots</h3>
                    <div class="slideshow-container" id="screenshots-slideshow">
                    <% game.screenshots.forEach((screenshot, index) => { %>
                        <div class="ss-img-slide" style="<%= index === 0 ? 'display:block;' : 'display:none;' %>">
                        <img src="<%= screenshot.url %>" alt="Screenshot <%= index + 1 %>" class="screenshot">
                        </div>
                    <% }) %>
                    <% if (game.screenshots.length > 1) { %>
                        <a class="SSprev" onclick="ssPlusSlides(-1)">&#10094;</a>
                        <a class="SSnext" onclick="ssPlusSlides(1)">&#10095;</a>                     
                    <% } %>
                    </div>

                    <div class="dot-div">
                    <% game.screenshots.forEach((_, index) => { %>
                        <span class="SSdot <%= index === 0 ? 'active' : '' %>" onclick="ssCurrentSlide(<%= index + 1 %>)"></span>
                    <% }) %>
                    </div>
                <% } %>
                </div>
                <div class="artwork-container">
                    <% if (game.artworks.length === 0) { %>
                     <p class="error-msg">No Artwork</p>
                     <div class="card-spacer"></div>
                    <% } %>
                <% if (game.artworks.length) { %>
                    <h3 style="text-align: center;">Artwork</h3>
                    <div class="slideshow-container" id="artworks-slideshow">
                    <% game.artworks.forEach((artwork, index) => { %>
                        <div class="art-img-slide" style="<%= index === 0 ? 'display:block;' : 'display:none;' %>">
                        <img src="<%= artwork.url %>" alt="Artwork <%= index + 1 %>" class="artwork">
                        </div>
                    <% }) %>
                    <% if (game.artworks.length > 1) { %>
                        <a class="Artprev" onclick="artPlusSlides(-1)">&#10094;</a>
                        <a class="Artnext" onclick="artPlusSlides(1)">&#10095;</a>                     
                    <% } %>

                    </div>

                    <div class="dot-div">
                    <% game.artworks.forEach((_, index) => { %>
                        <span class="Artdot <%= index === 0 ? 'active' : '' %>" onclick="artCurrentSlide(<%= index + 1 %>)"></span>
                    <% }) %>
                    </div>
                <% } %>
                </div>
                    <div class="video-container">
                        <% if (game.videos.length === 0) { %>
                            <p class="error-msg">No Videos</p>
                        <% } %>
                <% if (game.videos.length) { %>
                        <h3 style="text-align: center;">Videos</h3>
                        <div class="slideshow-container" id="videos-container">
                            <% game.videos.forEach((video, index) => { %>
                                <div class="video-slide" style="<%= index === 0 ? 'display:block;' : 'display:none;' %>">
                                    <iframe
                                        src="<%= video.url %>"
                                        class="video-frame"
                                        title="Video <%= index + 1 %>"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                    </iframe>
                                </div>
                            <% }) %>
                        <% if (game.videos.length > 1) { %>
                            <a class="Videoprev" onclick="videoPlusSlides(-1)">&#10094;</a>
                            <a class="Videonext" onclick="videoPlusSlides(1)">&#10095;</a>                         
                        <% } %>
                        </div>

                        <div class="dot-div">
                            <% game.videos.forEach((_, index) => { %>
                                <span class="Videodot <%= index === 0 ? 'active' : '' %>" onclick="videoCurrentSlide(<%= index + 1 %>)"></span>
                            <% }) %>
                        </div>
                <% } %>  
            </div>
            </div>
    <!-- Slideshow Javascript -->
    <script>
    let ssSlideIndex = 1;
    let artSlideIndex = 1;
    let videoSlideIndex = 1;

    function showVideoSlides(n) {
        const slides = document.getElementsByClassName("video-slide");
        const dots = document.getElementsByClassName("Videodot");

        if (!slides.length) return;

        if (n > slides.length) videoSlideIndex = 1;
        if (n < 1) videoSlideIndex = slides.length;

        for (let i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
        }

        for (let i = 0; i < dots.length; i++) {
            dots[i].classList.remove("active");
        }

        slides[videoSlideIndex - 1].style.display = "block";
        dots[videoSlideIndex - 1].classList.add("active");
    }

    function showSsSlides(n) {
        const slides = document.getElementsByClassName("ss-img-slide");
        const dots = document.getElementsByClassName("SSdot");

        if (!slides.length) return;

        if (n > slides.length) ssSlideIndex = 1;
        if (n < 1) ssSlideIndex = slides.length;

        for (let i = 0; i < slides.length; i++) {
        slides[i].style.display = "none";
        }

        for (let i = 0; i < dots.length; i++) {
        dots[i].classList.remove("active");
        }

        slides[ssSlideIndex - 1].style.display = "block";
        dots[ssSlideIndex - 1].classList.add("active");
    }

    function ssPlusSlides(n) {
        showSsSlides(ssSlideIndex += n);
    }

    function ssCurrentSlide(n) {
        showSsSlides(ssSlideIndex = n);
    }
    function videoPlusSlides(n) {
        showVideoSlides(videoSlideIndex += n);
    }

    function videoCurrentSlide(n) {
        showVideoSlides(videoSlideIndex = n);
    }

    function showArtSlides(n) {
        const slides = document.getElementsByClassName("art-img-slide");
        const dots = document.getElementsByClassName("Artdot");

        if (!slides.length) return;

        if (n > slides.length) artSlideIndex = 1;
        if (n < 1) artSlideIndex = slides.length;

        for (let i = 0; i < slides.length; i++) {
        slides[i].style.display = "none";
        }

        for (let i = 0; i < dots.length; i++) {
        dots[i].classList.remove("active");
        }

        slides[artSlideIndex - 1].style.display = "block";
        dots[artSlideIndex - 1].classList.add("active");
    }

    function artPlusSlides(n) {
        showArtSlides(artSlideIndex += n);
    }

    function artCurrentSlide(n) {
        showArtSlides(artSlideIndex = n);
    }

    showSsSlides(ssSlideIndex);
    showArtSlides(artSlideIndex);
    showVideoSlides(videoSlideIndex);
    </script>
</div>
<%- include('../Partials/footer') %>
<script src="/Reviewfunction.js"></script>
<script>
    const usernames = document.querySelectorAll('.activity-username');
    const userAvatars = document.querySelectorAll('.activity-avatar');

    usernames.forEach(user => {
        user.addEventListener('click', (e) => {
            const clickedUser = user.dataset.username
            const from = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/users/${clickedUser}?from=${from}`;
        })
    });

    userAvatars.forEach(avatar => {
        avatar.addEventListener('click', (e) => {
            const clickedUser = avatar.dataset.username
            const from = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/users/${clickedUser}?from=${from}`;
        })
    });
</script>
<script>
    const overlay = document.getElementById('confirm-overlay');
    const confirmBtn = document.getElementById('confirm-remove');
    const cancelBtn = document.getElementById('cancel-remove');
    const nameSpace = document.querySelector('.confirm-game-name');

    let pendingForm = null;

    document.querySelectorAll('.review-remove-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const card = form.closest('.game-review-card');
            const reviewTitle = card?.querySelector('.game-review-header h3')?.textContent?.trim() || 'this review';

            nameSpace.textContent = `"${reviewTitle}"`;
            pendingForm = form;
            overlay.hidden = false;
        });
    });

    confirmBtn.addEventListener('click', () => {
        if (pendingForm) {
            pendingForm.submit();
            pendingForm = null;
        }
        overlay.hidden = true;
    });

    cancelBtn.addEventListener('click', () => {
        pendingForm = null;
        overlay.hidden = true;
    });

    overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
            pendingForm = null;
            overlay.hidden = true;
        }
    });
</script>