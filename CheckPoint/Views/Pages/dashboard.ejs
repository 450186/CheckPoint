<%- include('../Partials/header') %>
<%- include('../Partials/navi', {activePage: 'dashboard'}) %>

<div class="main-content">
    <h2 class="title">
        <%= title %>
    </h2>
    <div class="welcome-message">
        <h3>Welcome back,
            <%= user.firstName %>!
        </h3>
    </div>
    <p class="error-msg"><%= errorMessage %></p>
    <div class="card-rows">
        <div class="dash-card stats-card">
            <h3>Your Stats</h3>
            <div class="stats-tabs">
                <button class="tab active" data-tab="vault">Vault</button>
                <button class="tab" data-tab="habits">Habits</button>
                <button class="tab" data-tab="activity">Activity</button>
            </div>
            <div class="tab-content active" id="vault">
                <div class="dash-stats-grid">
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-gamepad icon-purple"></i>
                        <h4><%= statsInfo.totalGames %></h4>
                        <div class="card-spacer"></div>
                        <p class="stat-label">Total Games</p>
                    </div>

                    <div class="stat-grid-item">
                        <i class="fa-solid fa-chart-pie icon-green"></i>
                        <h4><%= statsInfo.completion %>%</h4>
                        <div class="card-spacer"></div>
                        <p class="stat-label">Completion Rate</p>
                    </div>

                    <div class="stat-grid-item">
                        <i class="fa-solid fa-ranking-star icon-yellow"></i>
                        <h4>
                            <span class="star-rating-header">
                                <span><%= statsInfo.averageRating.toFixed(1) %> / 5</span>
                                <i class="fa-solid fa-star avg-rating-star icon-yellow"></i>
                            </span>
                        </h4>
                        <p class="stat-label">Average Rating</p>
                        <p class="stat-comment"><%= statsInfo.avgRatingComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-trophy icon-yellow"></i>
                        <h4><%= statsInfo.topGenre %></h4>
                        <p class="stat-label"><%= statsInfo.topGenreCount %> games</p>
                        <p class="stat-comment"><%= statsInfo.genreComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-pen icon-blue"></i>
                        <h4><%= statsInfo.reviewCount %></h4>
                        <p class="stat-label">Number of Reviews</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= statsInfo.reviewCountComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-diagram-project icon-purple"></i>
                        <h4><%= statsInfo.genreDiversity %></h4>
                        <p class="stat-label">Genre Diversity!</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= statsInfo.diversityComment %></p>
                    </div>
                </div>
                <h3>Vault Breakdown:</h3>
                <div class="community-status-legend">
                    <p><i class="fa-solid fa-circle-dot wishlist-dot"></i><strong>Wishlisted: </strong><%= statsInfo.wishlistCount %></p>
                    <p><i class="fa-solid fa-circle-dot completed-dot"></i><strong>Completed: </strong><%= statsInfo.completedCount %></p>
                    <p><i class="fa-solid fa-circle-dot dropped-dot"></i><strong>Dropped: </strong><%= statsInfo.droppedCount %></p>
                    <p><i class="fa-solid fa-circle-dot playing-dot"></i><strong>Playing: </strong><%= statsInfo.playingCount %></p>
                </div>
            </div>
            <div class="tab-content" id="habits">
                <div class="dash-stats-grid">
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-heart-circle-xmark icon-red"></i>
                        <h4><%= habitStats.dropRate %>%</h4>
                        <p class="stat-label">Drop Rate</p>
                        <p class="stat-comment"><%= habitStats.droppedComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-brain icon-purple"></i>
                        <h4><%= habitStats.playStyle %></h4>
                        <p class="stat-label">How you Play</p>
                        <p class="stat-comment"><%= habitStats.playStyleComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-layer-group icon-orange"></i>
                        <h4><%= habitStats.backlogCount %> games</h4>
                        <p class="stat-label">Your Backlog</p>
                        <p class="stat-comment"><%= habitStats.backlogComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-pen-nib icon-blue"></i>
                        <h4><%= habitStats.reviewRate %>%</h4>
                        <p class="stat-label"><%= habitStats.reviewCount %> / <%= habitStats.playedGamesTotal %> reviewed</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= habitStats.reviewComment %></p>
                    </div>
                </div>
            </div>
            <div class="tab-content" id="activity">
                <div class="dash-stats-grid">
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-pen-nib icon-blue"></i>
                        <h4><%= activityStats.recentReviews %></h4>
                        <p class="stat-label">Reviews this month</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= activityStats.recentReviewsComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-square-plus icon-green"></i>
                        <h4><%= activityStats.recentAdds %></h4>
                        <p class="stat-label">Added this month</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= activityStats.recentAddsComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-arrows-rotate icon-orange"></i>
                        <h4><%= activityStats.recentUpdates %></h4>
                        <p class="stat-label">Updates this month</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= activityStats.recentUpdatesComment %></p>
                    </div>
                    <div class="stat-grid-item">
                        <i class="fa-solid fa-star icon-yellow"></i>
                        <h4><%= activityStats.recentRatings %></h4>
                        <p class="stat-label">Ratings this month</p>
                        <div class="card-spacer"></div>
                        <p class="stat-comment"><%= activityStats.recentRatingsComment %></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="dash-card review-card">
            <h3>Your Reviews</h3>
            <p>See your most recent reviews here</p>
            <% if (YourReviews.length === 0) { %>
                <p class="no-items">Review games you've played for them to appear here</p>
            <% } %>
            <% if(YourReviews.length) { %>
                <div class="review-container">
                    <div class="slideshow-container" id="reviews-slideshow">
                        <% YourReviews.forEach((review, index) => { %>
                            <div class="review-slide"
                                style="<%= index === 0 ? 'display:block;' : 'display:none;' %>"
                            >
                                <div class="review-header">
                                    <div class="review-header-text">
                                        <p style="font-weight: bold; font-size: 1.2rem" class="review-game"><%= review.cachedName %></p>
                                        <p style="font-weight: bold;" class="review-title"><%= review.title %></p>
                                    </div>
                                    <img class="review-img-small" src="<%= review.cachedCoverUrl.replace('t_cover_big', 't_thumb') %>" alt="<%= review.cachedName %>">
                                </div>
                                <p class="review-body"><%= review.body %></p>
                            </div> 
                        <% }) %>
                    </div>
                    <div class="review-controls">
                        <% if (YourReviews.length > 1) { %>
                            <a class="reviewPrev" onclick="plusReviewSlides(-1)">&#10094;</a>
                        <% } %>
                    <div class="dot-div">
                        <% YourReviews.forEach((_, index) => { %>
                            <span class="reviewDot <%= index === 0 ? 'active' : '' %>" onclick="currentReviewSlide(<%= index + 1 %>)"></span>
                        <% }) %>
                    </div>
                    <% if (YourReviews.length > 1) { %>
                        <a class="reviewNext" onclick="plusReviewSlides(1)">&#10095;</a>
                    <% } %>
                    </div>
                </div>
            <% } %>
            <div class="card-spacer"></div>

        </div>
        <div class="dash-card high-rated-card">
            <h3>Highest Rated</h3>
            <p>Your highest rated games: </p>
                <% if (highestRated.length === 0) { %>
                    <p class="no-items">Rate games you've played via the library</p>
                <% } %>
                <div class="rating-list">
                    <% highestRated.forEach(HR => { %>
                        <div class="ranking-card" data-game-id="<%= HR.gameId %>">
                            <div class="ranking-card-header">
                                <img class="ranking-card-img" src="<%= HR.cachedCoverUrl.replace('t_cover_big', 't_thumb') %>" alt="<%= HR.cachedName %>">
                                <p class="ranking-card-title"><%= HR.cachedName %></p>
                            </div>
                            <div class="activity-star-rating">
                                <% for( let i = 1; i <= 5; i++) { %>
                                    <% if (HR.userRating >= i) { %>
                                        <i class="fa-solid fa-star"></i>
                                    <% } else if (HR.userRating >= i - 0.5) { %>
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                    <% } else { %>
                                        <i class="fa-regular fa-star"></i>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
        </div>
    </div>
    <div class="card-rows">
        <div class="dash-card" id="continue-card">
            <h3>Continue Playing</h3>
            <p>Pick up where you left off in your current games.</p>
            <% if (playing && playing.length > 0) { %>
                <div class="library-row 
                    <%= playing.length <= 4 ? "center4" : "" %>
                    <%= playing.length <= 3 ? "center3" : "" %>
                ">
                    <% playing.forEach(game => { %>
                    <div class="library-card game-card"
                      data-game-id="<%= game.gameId %>"
                      data-name="<%= game.cachedName %>"
                      data-cover="<%= game.cachedCoverUrl %>"
                      data-genres="<%= game.cachedGenres || '' %>"
                      data-rating="<%= game.cachedRating || '' %>"
                      data-release="<%= game.cachedRelease || '' %>"
                    >
                        <div class="game-card-header"> <img
                                src="<%= game.cachedCoverUrl %>"
                                alt="<%= game.cachedName %>"
                                class="game-cover">
                            <p><strong>
                                    <%= game.cachedName %>
                                </strong></p>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <p class="no-items">No games currently playing.</p>
            <% } %>
            <div class="card-spacer"></div> <button
                onclick="window.location.href='/library'"
                class="view-library">View Library</button>
        </div>
    </div>
    <div class="card-rows">
        <div class="dash-card">
            <h3>Recently Played</h3>
            <p>View your recently played games and jump back in with one click.
            </p>
            <p class="recent"> <i class="fa-solid fa-gamepad"></i> <i
                    class="fa-solid fa-gamepad"></i> <i
                    class="fa-solid fa-gamepad"></i> </p>
            <div class="card-spacer"></div>
        </div>
        <div class="dash-card">
            <h3>Recommended for You</h3>
            <p>Based on your gaming history, we think you'll love these titles.
            </p>
            <p class="recommended"> <i class="fa-solid fa-gamepad"></i> <i
                    class="fa-solid fa-gamepad"></i> <i
                    class="fa-solid fa-gamepad"></i> </p>
            <div class="card-spacer"></div>
        </div>
        <div class="dash-card">
            <h3>New Releases</h3>
            <p>Check out the latest games added to our library.</p>
            <p class="releases"> <i class="fa-solid fa-gamepad"></i> <i
                    class="fa-solid fa-gamepad"></i> <i
                    class="fa-solid fa-gamepad"></i> </p>
            <div class="card-spacer"></div>
        </div>
    </div>
</div>

<script>
    let reviewSlideIndex = 1;

    function showReviewSlides(n) {
        const slides = document.getElementsByClassName("review-slide");
        const dots = document.getElementsByClassName("reviewDot");

        if (!slides.length) return;

        if (n > slides.length) reviewSlideIndex = 1;
        if (n < 1) reviewSlideIndex = slides.length;

        for (let i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
        }

        for (let i = 0; i < dots.length; i++) {
            dots[i].classList.remove("active");
        }

        slides[reviewSlideIndex - 1].style.display = "block";
        dots[reviewSlideIndex - 1].classList.add("active");
    }
    function plusReviewSlides(n) {
        showReviewSlides(reviewSlideIndex += n);
    }
    function currentReviewSlide(n) {
        showReviewSlides(reviewSlideIndex = n);
    }


    showReviewSlides(reviewSlideIndex);

</script>
<script>
    const ratedGame = document.querySelectorAll('.ranking-card');

    ratedGame.forEach(card => {
        card.addEventListener('click', () => {
            const gameId = card.getAttribute('data-game-id');
            window.location.href = `/game/${gameId}?from=${encodeURIComponent('/dashboard')}`;
        });
    });
</script>
<script>
    const tabs = document.querySelectorAll('.tab');
    const tabContents = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            tabContents.forEach(tc => tc.classList.remove('active'));

            tab.classList.add('active');
            document.getElementById(tab.dataset.tab).classList.add('active');
        })
    })
</script>
<%- include('../Partials/footer') %>